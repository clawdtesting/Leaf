# Emperor backend environment. For local dev, copy to game.agi.eth/.env (the
# backend loads ../../../.env). In production (Render) set these in the dashboard
# — never commit real secrets.

# Port to listen on. Render sets this automatically; local dev defaults to 3001.
PORT=3001

# CORS allow-list: comma-separated origins permitted to call the API.
# Leave empty in dev (allows any origin). In production set your Vercel domain(s),
# e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=

# On-chain reads (AGIJobManager etc.). Without ETH_RPC_URL the backend runs in
# read-only-unavailable mode (fixtures/manual only).
ETH_RPC_URL=
CHAIN_ID=1

# IPFS publishing (Pinata). Required for real evidence publish + fetchback.
PINATA_JWT=

# OpenSea proxy for Mancer enumeration. Either set the chain slug directly, or
# set the collection slug and the backend discovers the chain from it.
OPENSEA_KEY=
OPENSEA_COLLECTION=chain-mancers
OPENSEA_CHAIN=

# Operator address used when building unsigned completion transactions.
OPERATOR_ADDRESS=
