# Frontend (Vite) environment — copy to `.env` for local dev, or set these as
# Project Environment Variables in Vercel. All are inlined at BUILD time, so they
# must be present before `pnpm build` runs (a rebuild is needed after changing them).
#
# NOTE: every VITE_* value ships inside the public JS bundle. Only put values here
# that are safe to expose to the browser (a read-only, domain-restricted RPC key is
# fine; never put the Pinata JWT, OpenSea key, or any signing key here — those live
# only in the backend).

# Emperor backend origin. Local dev can omit this (defaults to http://localhost:3001).
# In production set it to your deployed backend URL, e.g. https://api.your-domain.com
VITE_API_BASE=

# Mancer NFT contract (Robinhood Chain).
VITE_MANCER_CONTRACT_ADDRESS=0x797a2e030b7e49107c8f07bf0300ea9cae88ca57

# Robinhood Chain RPC (Alchemy). Prefer a browser/domain-restricted key.
VITE_ROBINHOOD_RPC_URL=

# Optional: highest Mancer token id to scan in the on-chain fallback (default 20000).
VITE_MANCER_MAX_ID=20000
